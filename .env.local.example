# Copy this file to .env.local and fill in your own values.
# .env.local is already gitignored — never commit real keys.

# --- OpenRouter (course generation — replaces the direct Anthropic call) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Anthropic (kept only as a fallback / unused once OPENROUTER_API_KEY is set) ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Google Drive import ("Ajouter une source" > onglet Drive) ---
# Meant to be public/client-exposed (NEXT_PUBLIC_) — restricted server-side
# by Google via "Authorized JavaScript origins" on the Client ID, not by
# secrecy. Only a Client ID is needed: the browser talks to the Drive REST
# API directly with an OAuth Bearer token (no Google Picker widget, so no
# API key / "Google Picker API" enablement is used anymore).
# Setup in Google Cloud Console (console.cloud.google.com), same project:
#   1. Enable the "Google Drive API".
#   2. Credentials > Create Credentials > OAuth client ID > Web application.
#      Add http://localhost:3000 (and your real domain once deployed) under
#      "Authorized JavaScript origins". Copy the Client ID below.
#   3. OAuth consent screen: add the scope
#      https://www.googleapis.com/auth/drive.readonly (broader than a
#      Picker-style drive.file — this lets the app list Récents/Mon Drive/
#      Partagés avec moi, not just receive one already-picked file), and add
#      any test-user email addresses while the app is in "Testing"
#      publishing status (anyone outside that list gets an "access blocked"
#      error).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Supabase (caching + subscriptions + auth) ---
# Project Settings > API in your Supabase dashboard.
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security — server-side only,
# never expose it to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The publishable/anon key IS meant to be public — it's what the browser
# uses to talk to Supabase Auth directly (sign up / sign in / sign out).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Chargily Pay V2 (DZD payments: Edahabia / CIB) ---
# Dashboard > Developers Corner: https://pay.chargily.com/dashboard/developers-corner
# Use the test_sk_... key while integrating; switch to live_sk_... + the live
# CHARGILY_API_BASE only once you're ready to accept real payments.
CHARGILY_SECRET_KEY=
CHARGILY_API_BASE=https://pay.chargily.net/test/api/v2
# CHARGILY_API_BASE=https://pay.chargily.net/api/v2

# Base URL of this app, used to build Chargily success/failure/webhook URLs.
# Required once you deploy somewhere other than localhost (Chargily can't
# reach a webhook on your own machine) — e.g. https://med-art-ai.example.com
APP_URL=

# --- Web Push (flashcard reminders — public/sw.js, lib/push/*) ---
# Generate a real pair with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY and NEXT_PUBLIC_VAPID_PUBLIC_KEY must be the SAME value —
# the client needs it (public, safe to expose) to create a PushSubscription;
# the server needs it again (paired with the private key) to actually send.
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A "mailto:" address or "https://" URL identifying you to push services —
# required by the Web Push protocol, contacted only if a push service flags
# your server as abusive.
VAPID_SUBJECT=mailto:you@example.com

# Shared secret for POST /api/push/dispatch — the REAL hourly dispatch route,
# meant to be called by an external cron (Vercel Cron, GitHub Actions, an
# uptime service), never by anything inside this app. Generate any long
# random string; whatever triggers that route must send it back as
# `Authorization: Bearer <this value>`. See that route's own header comment
# for the exact vercel.json config if you deploy there.
CRON_SECRET=
