# Copy this file to .env.local and fill in your own values.
# .env.local is already gitignored — never commit real keys.

# --- OpenRouter (course generation — replaces the direct Anthropic call) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Anthropic (kept only as a fallback / unused once OPENROUTER_API_KEY is set) ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Supabase (caching + subscriptions + auth) ---
# Project Settings > API in your Supabase dashboard.
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security — server-side only,
# never expose it to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The publishable/anon key IS meant to be public — it's what the browser
# uses to talk to Supabase Auth directly (sign up / sign in / sign out).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Chargily Pay V2 (DZD payments: Edahabia / CIB) ---
# Dashboard > Developers Corner: https://pay.chargily.com/dashboard/developers-corner
# Use the test_sk_... key while integrating; switch to live_sk_... + the live
# CHARGILY_API_BASE only once you're ready to accept real payments.
CHARGILY_SECRET_KEY=
CHARGILY_API_BASE=https://pay.chargily.net/test/api/v2
# CHARGILY_API_BASE=https://pay.chargily.net/api/v2

# Base URL of this app, used to build Chargily success/failure/webhook URLs.
# Required once you deploy somewhere other than localhost (Chargily can't
# reach a webhook on your own machine) — e.g. https://med-art-ai.example.com
APP_URL=
