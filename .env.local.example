# Copy this file to .env.local and fill in your own values.
# .env.local is already gitignored — never commit real keys.

# --- OpenRouter (course generation — replaces the direct Anthropic call) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Anthropic (kept only as a fallback / unused once OPENROUTER_API_KEY is set) ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Google Gemini (Mind Map structuring — lib/ai/gemini.ts) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Ideogram (Mind Map image generation — app/api/generate-mindmap) ---
# Get a key at https://ideogram.ai/manage-api
# Not required in development: USE_MOCK_AI/NODE_ENV=development returns a
# static placeholder image instead of a real (paid, per-call) request.
IDEOGRAM_API_KEY=

# --- Google Drive import ("Ajouter une source" > onglet Google Drive) ---
# Both are meant to be public/client-exposed (NEXT_PUBLIC_) — they're
# restricted server-side by Google via "Authorized JavaScript origins" (on
# the Client ID) and API key referrer/API restrictions, not by secrecy.
# Setup in Google Cloud Console (console.cloud.google.com), same project:
#   1. Enable the "Google Picker API" and the "Google Drive API".
#   2. Credentials > Create Credentials > OAuth client ID > Web application.
#      Add http://localhost:3000 (and your real domain once deployed) under
#      "Authorized JavaScript origins". Copy the Client ID below.
#   3. Credentials > Create Credentials > API key. Restrict it to the
#      "Google Picker API" (Application restrictions > HTTP referrers,
#      matching the same origins as step 2). Copy the key below.
#   4. OAuth consent screen: add the scope
#      https://www.googleapis.com/auth/drive.file, and add any test-user
#      email addresses while the app is in "Testing" publishing status
#      (anyone outside that list gets an "access blocked" error).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=

# --- Supabase (caching + subscriptions + auth) ---
# Project Settings > API in your Supabase dashboard.
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security — server-side only,
# never expose it to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The publishable/anon key IS meant to be public — it's what the browser
# uses to talk to Supabase Auth directly (sign up / sign in / sign out).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Chargily Pay V2 (DZD payments: Edahabia / CIB) ---
# Dashboard > Developers Corner: https://pay.chargily.com/dashboard/developers-corner
# Use the test_sk_... key while integrating; switch to live_sk_... + the live
# CHARGILY_API_BASE only once you're ready to accept real payments.
CHARGILY_SECRET_KEY=
CHARGILY_API_BASE=https://pay.chargily.net/test/api/v2
# CHARGILY_API_BASE=https://pay.chargily.net/api/v2

# Base URL of this app, used to build Chargily success/failure/webhook URLs.
# Required once you deploy somewhere other than localhost (Chargily can't
# reach a webhook on your own machine) — e.g. https://med-art-ai.example.com
APP_URL=
